# Required
TINYFISH_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_EN=
ELEVENLABS_VOICE_HI=

AGENTCAST_HOME=~/.agentcast

AGENTCAST_SECRET_KEY=          
#32-byte base64; encrypts local storageState/credentials

WORKER_URL=http://localhost:4000

# LLM backend: uses your logged-in coding-agent CLI, no API key needed

AGENTCAST_LLM=auto             
# auto | claude-code | opencode | codex | anthropic-api


AGENTCAST_LLM_SMART=           
# optional backend override for director + script

AGENTCAST_LLM_FAST=            
# optional backend override for brief, judge, healing

AGENTCAST_LLM_SMART_MODEL=     
# optional; claude-code default "opus"

AGENTCAST_LLM_FAST_MODEL=      
# optional; claude-code default "haiku"
#
AGENTCAST_LLM_CONCURRENCY=2
ANTHROPIC_API_KEY=             
# optional, only used when AGENTCAST_LLM=anthropic-api
